{
  "schemaVersion": 1,
  "id": "streamchatbridge",
  "version": "${version}",
  "name": "Stream Chat Bridge",
  "description": "A client-side Fabric mod that bridges Minecraft chat with Twitch and Kick.",
  "authors": [
    "Kryp Arnold"
  ],
  "contact": {
    "homepage": "https://github.com/emirhanpisgin/stream-chat-bridge",
    "sources": "https://github.com/emirhanpisgin/stream-chat-bridge",
    "issues": "https://github.com/emirhanpisgin/stream-chat-bridge/issues"
  },
  "license": "MIT",
  "icon": "assets/streamchatbridge/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kryp.streamchatbridge.StreamChatBridge"
    ],
    "client": [
      "com.kryp.streamchatbridge.StreamChatBridgeClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
